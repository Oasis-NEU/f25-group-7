# Copy to backend-folder/.env and fill in. Loaded automatically via dotenv by
# both index.js (the dev API) and run-scrape.js (the scraper).

# Project URL from Supabase > Project Settings > Data API
SUPABASE_URL="https://rxxcpxytbsziedhpztcy.supabase.co"

# Service role key. Required: the scraper writes, and the dev API reads tables
# that the anon key cannot see. Keep this out of git and out of the frontend.
SUPABASE_SERVICE_ROLE_KEY=""

# Optional. Point the scraper at a specific Chrome binary if the default for
# your platform is wrong.
# CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
