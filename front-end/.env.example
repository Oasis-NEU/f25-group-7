# Copy to front-end/.env and fill in. Vite inlines these at build time, so any
# change needs a rebuild.
#
# Accounts, rankings, votes and the tracker run on Firebase. From the Firebase
# console: Project settings > General > Your apps > Web app > Config.
# These values are public by design; the Firestore rules are what protect data.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project"
VITE_FIREBASE_APP_ID=""
# The address verification emails come from, when custom SMTP is set up in Firebase.
VITE_EMAIL_SENDER=""

# Local development against the emulators (npm run emulators):
#   VITE_FIREBASE_EMULATOR=1
#   VITE_FIREBASE_PROJECT_ID="demo-nu-dining"

# The serverless functions in front-end/api read these from the Vercel project
# environment, not from this file. They are listed here so the set is in one place.
#   SUPABASE_URL               same project URL as above
#   SUPABASE_SERVICE_ROLE_KEY  service role key, server side only
#   CRON_SECRET                required by /api/scrape; the endpoint refuses to
#                              run when it is unset
